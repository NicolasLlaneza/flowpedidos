# ============================================
# TFI — Variables de entorno
# Copiá este archivo a .env y completá los valores
# ============================================

# --- PostgreSQL ---
# Superuser usado por n8n para sus tablas internas en `public`
POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambiame_por_una_clave_fuerte
POSTGRES_DB=tfi

# Usuario operativo del pipeline con permisos solo sobre schema `tfi`
# Generar con: openssl rand -base64 24 | tr -d '/+=' | head -c 32
TFI_APP_USER=tfi_app
TFI_APP_PASSWORD=generar_password_fuerte

# Puerto del host para acceder a postgres desde scripts. Cambiar a 5433 si
# ya tenés un PostgreSQL local ocupando el 5432.
PG_HOST_PORT=5433

# --- n8n ---
# Generá con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=generar_con_openssl_rand_hex_32

# --- APIs externas ---
# OpenAI (modelo principal del pipeline)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (modelo comparativo, Fase 6)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
