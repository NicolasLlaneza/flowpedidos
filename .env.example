# ============================================
# TFI — Variables de entorno
# Copiá este archivo a .env y completá los valores
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambiame_por_una_clave_fuerte
POSTGRES_DB=tfi

# --- n8n ---
# Generá con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=generar_con_openssl_rand_hex_32

# --- APIs externas ---
# OpenAI (modelo principal del pipeline)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (modelo comparativo, Fase 6)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
