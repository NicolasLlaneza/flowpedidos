# =============================================================================
# TFI - Variables de entorno
# Copiar a .env y completar con valores reales. NUNCA commitear .env.
# =============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiame_postgres
POSTGRES_DB=tfi
PG_HOST_PORT=5433
POSTGRES_TFI_APP_PASSWORD=cambiame_tfi_app

# n8n - generar con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=cambiame_genera_con_openssl_rand_hex_32

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (solo Fase 6)
# ANTHROPIC_API_KEY=sk-ant-...

# Meta WhatsApp Business API (Cloud API)
# Meta for Developers -> Tu app -> WhatsApp -> Configuracion de API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# WooCommerce
# Secret del webhook (WooCommerce -> Settings -> Advanced -> Webhooks -> Secret).
# Se usa en validate-wc-webhook.js para verificar la firma HMAC-SHA256.
# Si queda vacio, la validacion de firma se OMITE (solo para dev).
WC_WEBHOOK_SECRET=
