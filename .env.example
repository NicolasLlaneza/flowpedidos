# =============================================================================
# TFI - Variables de entorno
# Copiar a .env y completar con valores reales. NUNCA commitear .env.
# =============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiame_postgres
POSTGRES_DB=tfi
PG_HOST_PORT=5433
POSTGRES_TFI_APP_PASSWORD=cambiame_tfi_app

# n8n - generar con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=cambiame_genera_con_openssl_rand_hex_32

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (solo Fase 6)
# ANTHROPIC_API_KEY=sk-ant-...

# Meta WhatsApp Business API (Cloud API)
# Meta for Developers -> Tu app -> WhatsApp -> Configuracion de API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# WooCommerce (multicanal real). WP + MySQL en docker-compose junto a n8n.
WP_HOST_PORT=8080
WP_DB_USER=wp
WP_DB_PASSWORD=cambiame_wp
MYSQL_ROOT_PASSWORD=cambiame_root

# =============================================================================
# Variables nuevas para Bloque C (agregar a tu .env y a .env.example).
# El script scripts/env-check.mjs valida que estén presentes antes de
# correr wc-setup.mjs y ml-setup.mjs.
# =============================================================================

# --- WooCommerce (canal WC) ------------------------------------------------
# Credenciales del admin del WordPress local (Paso 1 del scripts/README.md)
WC_ADMIN_USER=admin
WC_ADMIN_PASSWORD=

# WooCommerce REST API — WC → Ajustes → Avanzado → REST API → Añadir clave
# permisos Read/Write; se copia UNA SOLA VEZ al crearla
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# --- Mercado Libre (canal ML) ---------------------------------------------
# App creada en developers.mercadolibre.com.ar/panel (Paso 1 del README)
ML_APP_CLIENT_ID=
ML_APP_CLIENT_SECRET=

# Tokens generados por scripts/ml-setup.mjs — NO completar a mano
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# --- ngrok (expone n8n a Mercado Libre) -----------------------------------
# dashboard.ngrok.com → Auth → Your Authtoken
NGROK_AUTHTOKEN=

# opcional: dominio estático (dashboard.ngrok.com → Domains → New)
# si queda vacío, ngrok asigna un dominio efímero por corrida
NGROK_STATIC_DOMAIN=

