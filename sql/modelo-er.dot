digraph ER {
graph [rankdir=LR, fontname="Helvetica", nodesep=0.5, ranksep=1.0, pad=0.3, dpi=200];
node [shape=plaintext, fontname="Helvetica", fontsize=11];
edge [fontname="Helvetica", fontsize=9, color="#444444", arrowhead=crow, arrowtail=tee, dir=both];
customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white" POINT-SIZE="13"><B>tfi.customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="id_w"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">uuid</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="id_e"><FONT COLOR="#1f4e79" POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="external_id_w">external_id</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">varchar(128)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="external_id_e"><FONT COLOR="#1f4e79" POINT-SIZE="9">UQ¹</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="channel_w">channel</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">varchar(32)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="channel_e"><FONT COLOR="#1f4e79" POINT-SIZE="9">UQ¹</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="pseudonym_w">pseudonym</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">varchar(64)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="pseudonym_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="full_name_w">full_name</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="full_name_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="email_w">email</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="email_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="phone_w">phone</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">varchar(64)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="phone_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="email_hash_w">email_hash</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">char(64)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="email_hash_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="phone_hash_w">phone_hash</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">char(64)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="phone_hash_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="created_at_w">created_at</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="created_at_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="updated_at_w">updated_at</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="updated_at_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
