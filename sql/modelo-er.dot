order_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white" POINT-SIZE="13"><B>tfi.order_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="id_w"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">uuid</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="id_e"><FONT COLOR="#1f4e79" POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="order_id_w">order_id</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">uuid</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="order_id_e"><FONT COLOR="#1f4e79" POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="sku_w">sku</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">varchar(128)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="sku_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="product_name_w">product_name</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">varchar(512)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="product_name_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="quantity_w">quantity</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="quantity_e"><FONT COLOR="#1f4e79" POINT-SIZE="9">CHK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="unit_price_w">unit_price</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">numeric(14,2)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="unit_price_e"><FONT COLOR="#1f4e79" POINT-SIZE="9">CHK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="delivery_status_w">delivery_status</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">varchar(32)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="delivery_status_e"><FONT COLOR="#1f4e79" POINT-SI