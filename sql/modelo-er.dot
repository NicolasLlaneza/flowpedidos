raw_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#7a3e00"><FONT COLOR="white" POINT-SIZE="13"><B>tfi.raw_events</B></FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#eeeeee"><FONT POINT-SIZE="9"><I>nueva en v1.3.0 · persistida antes del ACK</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="id_w"><B>id</B></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">uuid</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="id_e"><FONT COLOR="#1f4e79" POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="channel_w">channel</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">varchar(32)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="channel_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="payload_w">payload</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">jsonb</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="payload_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="received_at_w">received_at</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="received_at_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="processed_at_w">processed_at</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="processed_at_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
schema_version [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white" POINT-SIZE="13"><B>tfi.schema_version</B></FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#eeeeee"><FONT POINT-SIZE="9"><I>registro de migraciones</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="version_w"><B>version</B></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">varchar(16)</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="version_e"><FONT COLOR="#1f4e79" POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="applied_at_w">applied_at</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="applied_at_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="description_w">description</TD><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="description_e"><FONT COLOR="#1f4e79" POINT-SIZE="9"> </FONT></TD></TR></TABLE>>];
customers:id_e:e -> orders:customer_id_w:w [label="1 : N\nON DELETE RESTRICT"];
orders:id_e:e -> order_items:order_id_w:w [label="1 : N\nON DELETE CASCADE"];
orders:id_e:e -> ai_notifications:order_id_w:w [label="1 : N\nON DELETE CASCADE"];
orders:id_e:e -> audit_log:order_id_w:w [label="1 : N (opcional)\nON DELETE SET NULL", arrowtail=teeodot];
{rank=same; order_items; ai_notifications; audit_log}
{rank=same; customers; raw_events; schema_version}
raw_events -> schema_version [style=invis];
legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="4" COLOR="#555555"><TR><TD BGCOLOR="#fff2cc">v1.2.0 / v1.3.0</TD><TD ALIGN="LEFT">columna agregada por migración (sql/03_wa_dispatch.sql, sql/04_instrumentation.sql)</TD></TR><TR><TD>UQ¹, UQ²</TD><TD ALIGN="LEFT">restricción de unicidad compuesta (external_id, channel)</TD></TR><TR><TD>CHK</TD><TD ALIGN="LEFT">restricción de verificación</TD></TR></TABLE>>];
schema_version -> legend [style=invis];
}